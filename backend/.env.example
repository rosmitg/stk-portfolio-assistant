# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── LangSmith observability ────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=stk-portfolio-assistant

# ── Voyage AI embeddings ───────────────────────────────────────────────────────
VOYAGE_API_KEY=your_voyage_api_key_here

# ── News API ───────────────────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ── Alpaca Markets ─────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stk_portfolio

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=portfolio_data

# ── Supabase auth ──────────────────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# JWT verified via public JWKS endpoint — no JWT secret needed

# ── Resend email ───────────────────────────────────────────────────────────────
# Brief emails are sent by the Watchman service; configured here for parity.
RESEND_API_KEY=your_resend_api_key_here
